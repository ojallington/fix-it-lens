{
  "name": "@fix-it-lens/contracts",
  "version": "1.50.0",
  "private": true,
  "type": "module",
  "description": "TypeScript types generated from contracts/*.schema.json (make contracts). Never edit src/*.ts by hand.",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./validate": "./src/validate.ts"
  },
  "scripts": {
    "gen": "node gen.mjs src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
