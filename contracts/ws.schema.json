    "CapClose": {
      "description": "Not a message: the reason text of a WebSocket close with code 4429, as JSON. A spend cap was reached; the same error codes as a REST 429.",
      "type": "object",
      "required": [
        "error",
        "reopens_at"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "home_cap",
            "global_cap",
            "judges_cap"
          ]
        },
        "reopens_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "ISO 8601 UTC; the next UTC midnight for home_cap; null for judges_cap (the link's spend is a total, ever, so it does not reopen), and for global_cap when no reopening time is known"
        }
      },
      "x-close-code": 4429,
      "if": {
        "properties": {
          "error": {
            "const": "home_cap"
          }
        }
      },
      "then": {
        "properties": {
          "reopens_at": {
            "type": "string"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "error": {
              "const": "judges_cap"
            }
          }
        },
        "then": {
          "properties": {
            "reopens_at": {
              "type": "null"
            }
          }
        }
      }
    },
    "GoneClose": {
      "description": "Not a message: the reason text of a WebSocket close with code 4410, as JSON. The household was deleted (DELETE /household): the server closes every open session of it before it removes the files, and closes any later hello for it the same way. Final: the phone does not reconnect and goes back to the start.",
      "type": "object",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string",
          "const": "household_deleted"
        }
      },
      "x-close-code": 4410
    }
  },
