          "$ref": "#/$defs/RuleId"
        },
        "line": {
          "type": "string"
        },
        "words": {
          "type": "integer",
          "minimum": 0,
          "description": "How many words were held"
        }
      },
      "description": "A sentence G0 held. The held text is never sent; the amber bar shows the rule id and line."
    },
